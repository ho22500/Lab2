<?xml version="1.0"?>
<robot name="table">

  <!-- define the colors -->
  <material name="brown">
    <color rgba="0.54 0.27 0.07 1.0" />
  </material>
  <material name="light_grey">
    <color rgba="0.8 0.8 0.8 1.0" />
  </material>
  
  <!-- create link fixed to the "world" -->
  <link name="world" />

    <!-- Base Joint -->
  <joint name="base_joint" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin rpy="0 0 0" xyz="0 0 0" />
  </joint>

  <link name="base_link" />

  <!-- joint from "world" to "top"-->
  <joint name="top_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 1" />
    <parent link="world" />
    <child link="top" />
  </joint>

  <!-- Top -->
  <link name="top">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.025" />
      <geometry>
        <box size="2 1 0.05" />
      </geometry>
      <material name="brown" />
    </visual>
  </link>

  <!-- Joint 1 -->
  <joint name="joint1" type="fixed">
    <parent link="top" />
    <child link="leg1" />
    <origin rpy="0 0 0" xyz="0.95 0.45 -0.05" />
  </joint>

  <!-- Leg 1 -->
  <link name="leg1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.475" />
      <geometry>
        <cylinder radius="0.05" length="0.95"/>
      </geometry>
      <material name="light_grey" />
    </visual>
  </link>

  <!-- Joint 2 -->
  <joint name="joint2" type="fixed">
    <parent link="top" />
    <child link="leg2" />
    <origin rpy="0 0 0" xyz="0.95 -0.45 -0.05" />
  </joint>

  <!-- Leg 2 -->
  <link name="leg2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.475" />
      <geometry>
        <cylinder radius="0.05" length="0.95"/>
      </geometry>
      <material name="light_grey" />
    </visual>
  </link>

  <!-- Joint 3 -->
  <joint name="joint3" type="fixed">
    <parent link="top" />
    <child link="leg3" />
    <origin rpy="0 0 0" xyz="-0.95 -0.45 -0.05" />
  </joint>

  <!-- Leg 3 -->
  <link name="leg3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.475" />
      <geometry>
        <cylinder radius="0.05" length="0.95"/>
      </geometry>
      <material name="light_grey" />
    </visual>
  </link>

  <!-- Joint 4 -->
  <joint name="joint4" type="fixed">
    <parent link="top" />
    <child link="leg4" />
    <origin rpy="0 0 0" xyz="-0.95 0.45 -0.05" />
  </joint>

  <!-- Leg 4 -->
  <link name="leg4">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.475" />
      <geometry>
        <cylinder radius="0.05" length="0.95"/>
      </geometry>
      <material name="light_grey" />
    </visual>
  </link>
  
</robot>